DATABASE_URL=postgres://localhost:5432/hledsluverd
DATABASE_URL_TEST=postgres://localhost:5432/hledsluverd_test
OCM_API_KEY=
NTFY_TOPIC=
TOMTOM_API_KEY=
# Google photos, all optional; unset = no photos and no calls to Google (docs/deploy.md).
# Street View on the "Nálægt mér" cards: a key for the Street View Static API only, plus
# its URL signing secret. Budget: images handed out per day, default 300 (~10 000/month).
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_SIGNING_SECRET=
# GOOGLE_STREETVIEW_DAILY_BUDGET=300
# Place photos on the /kort station card (Places UI Kit): a BROWSER key, sent to every
# visitor, so lock it to the site's address. Stations need Google place IDs first:
# `npm run match:google`, with a separate server key for Places API (New).
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_PLACES_API_KEY=

# --- Production only (see docs/deploy.md) -----------------------------------
# In production, .env is read BOTH by dotenv (tsx scripts) and by systemd
# EnvironmentFile= — keep it to plain KEY=value lines: no `export`, no quotes,
# no $VAR expansion, no `#` or spaces inside values (hex secrets via
# `openssl rand -hex 24`).
# ORIGIN=https://hledsluverd.is
# HOST=127.0.0.1
# PORT=3000
# HEALTHCHECKS_URL=https://hc-ping.com/<uuid-of-the-scrape-check>
# HEALTHCHECKS_BACKUP_URL=https://hc-ping.com/<uuid-of-the-backup-check>
