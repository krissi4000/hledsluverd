[Unit]
Description=Hledsluverd - daily station sync (supercharge.info, e1 map, Virta)
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=hledsluverd
Group=hledsluverd
WorkingDirectory=/srv/hledsluverd/app
EnvironmentFile=/srv/hledsluverd/app/.env
ExecStart=/usr/bin/bash /srv/hledsluverd/app/deploy/bin/sync-stations.sh
TimeoutStartSec=30min
